# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/desi_signs

# Authentication Secret
JWT_SECRET=desi_signs_super_secure_jwt_secret_key_2026_edmonton

# Default Admin Credentials
ADMIN_EMAIL=admin@desisigns.ca
ADMIN_PASSWORD=AdminDesiSigns2026!

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Separate Express backend (start with: npm run dev:backend)
BACKEND_PORT=4000
BACKEND_URL=http://127.0.0.1:4000

# Cloudinary (Optional image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Quote + Contact form email notifications (Nodemailer SMTP)
# Destination inbox for new quote alerts
QUOTE_NOTIFICATION_TO=save@desisigns.com
# Optional override for Contact Us enquiries (defaults to QUOTE_NOTIFICATION_TO / save@desisigns.com)
CONTACT_NOTIFICATION_TO=save@desisigns.com
# Verified sender shown in the From header (use your SMTP account / verified domain)
SMTP_FROM="Desi Signs <save@desisigns.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API (Meta) — automatic quote alerts to your business WhatsApp
# Do not invent a number: set WHATSAPP_TO to your verified WhatsApp business number in E.164
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=v21.0
# Optional approved template (recommended for production policy compliance)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

