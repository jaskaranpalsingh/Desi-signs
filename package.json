{
  "name": "desi-signs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-web next dev --port 3000",
    "dev:admin": "cross-env NEXT_DIST_DIR=.next-admin next dev --port 3001",
    "dev:backend": "tsx watch --env-file=.env.local backend/src/index.ts",
    "backend": "tsx --env-file=.env.local backend/src/index.ts",
    "build": "cross-env NEXT_DIST_DIR=.next-web next build",
    "build:admin": "cross-env NEXT_DIST_DIR=.next-admin next build",
    "start": "cross-env NEXT_DIST_DIR=.next-web next start --port 3000",
    "start:admin": "cross-env NEXT_DIST_DIR=.next-admin next start --port 3001",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^14.10.1",
    "gsap": "^3.15.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.70.0",
    "mongoose": "^9.12.0",
    "multer": "^2.0.2",
    "next": "16.4.5",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
